# Gateway reads environment variables from your shell (no secrets required).
# export WIIM_HOST=192.168.1.42
# Only if the configured WiiM uses a self-signed certificate:
# export WIIM_ALLOW_SELF_SIGNED=true
# Live lyrics remain disabled until you opt in after terms/coverage review:
# export LYRICS_PROVIDER=lrclib
# export WEB_ORIGIN=http://127.0.0.1:3000
# export GATEWAY_PORT=8787
# Paired phone controls (enable in Settings after starting):
# Set ROOM_OWNER=1 ONLY on the loopback display web server, never on a LAN server.
# export ROOM_OWNER=1
# export ROOM_STATE_FILE=.data/room.json
# export ROOM_LAN_PORT=3211
